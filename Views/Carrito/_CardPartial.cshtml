@model Producto

<div class="card h-100 shadow-sm producto-card">
    <a asp-controller="Comprar"
       asp-action="Detalle"
       asp-route-id="@Model.ProductoId"
       class="text-decoration-none text-reset d-flex flex-column h-100">

        <img src="@(Model.ArchivoId == null 
            ? "https://placehold.co/300x200/FFF/999?text=Artículo" 
            : $"{ViewBag.Url}/api/archivos/{Model.ArchivoId}")"
             alt="@Model.Titulo"
             class="card-img-top"
             style="max-height: 200px; object-fit: contain;">

        <div class="card-body d-flex flex-column">
            <p class="card-text">@Model.Titulo</p>

            <h5 class="card-title mt-auto">@Html.DisplayFor(m => m.Precio)</h5>

            <p class="card-text">
                @foreach (var cat in Model.Categorias ?? Enumerable.Empty<Categoria>())
                {
                    <span class="badge rounded-pill text-bg-warning">@cat.Nombre</span>
                }
            </p>

            <p class="mt-auto card-text text-success fw-semibold small">
                <i class="bi bi-lightning-fill"></i> Envío gratis
            </p>
        </div>
    </a>
</div>
